#
# Ghostty Config
# @see - https://ghostty.org/docs/config
#

# Theme
theme = Catppuccin Mocha

# Machine-local overrides, loaded last so they win. `?` makes the include
# optional, so a machine without the file (macOS) just keeps the theme above.
# Same convention as zsh/.zshrc sourcing $ZDOTDIR/private.sh.
config-file = ?"~/.config/ghostty/private.conf"

# Window
# window-decoration = false # conflict with "toggle_fullscreen"
maximize = true
macos-titlebar-style = hidden

# macOS Option key as Alt (left only)
macos-option-as-alt = left

# Font
# Quoted so omarchy-font-set can find it: it rewrites this line with
#   sed -i "s/font-family = \".*\"/font-family = \"$font_name\"/g"
# which only matches a quoted value. Unquoted, changing the system font
# from the Omarchy menu left the terminal alone and reported no error.
# Ghostty accepts either form.
font-family = "FiraCode Nerd Font"
font-size = 16
font-thicken = true
adjust-cell-height = 15%

# Cursor
# ssh-env is off by default (the resolved value reads no-ssh-env), so SSH
# sessions land without the terminfo this terminal expects. Ghostty requires the
# shell-integration options to be given together, which is why the cursor
# setting shares the line.
shell-integration-features = no-cursor,ssh-env
cursor-style = block
cursor-style-blink = false
custom-shader = cursor_smear.glsl
custom-shader-animation = always

# Clipboard (OSC52 - enabled by default in Ghostty)
clipboard-read = allow
clipboard-write = allow

# QoL
mouse-hide-while-typing = true
window-padding-balance = true
copy-on-select = clipboard
scrollback-limit = 10000

# Keybindings
keybind = super+ctrl+f=toggle_fullscreen

# Send Shift+Enter and Alt+Shift+Enter as CSI-u so a TUI can tell them from
# Enter and Alt+Enter. The legacy encoding collapses both pairs, so without
# this an editor or agent that binds Shift+Enter to "newline, do not submit"
# never sees it, and tmux cannot match M-S-Enter. Carried over from Omarchy's
# ghostty config; it pairs with the extended-keys/csi-u settings tmux.conf
# already sets, and nothing here is platform-specific.
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
