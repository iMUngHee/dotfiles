# codex/config.toml.template — keys ENFORCED on every bootstrap (deep-merge).
# All other keys (trust levels, NUX counters, mcp_servers, etc.) are
# user/machine-managed and preserved by the merge.

project_doc_max_bytes = 65536
model = "gpt-6-astra"
model_reasoning_effort = "medium"

# Default startup automation = maximum local autonomy (no approvals + no sandbox)
approval_policy = "never"
approvals_reviewer = "user"
sandbox_mode = "danger-full-access"

[features]
apps = false
plugins = false
skill_mcp_dependency_install = false

[tui]
theme = "catppuccin-mocha"
notifications = false
vim_mode_default = true
status_line_use_colors = true
status_line = [
  "model-with-reasoning",
  "run-state",
  "task-progress",
  "context-used",
  "five-hour-limit",
  "weekly-limit",
  "current-dir",
  "git-branch",
]
terminal_title = ["app-name", "project-name", "run-state", "task-progress"]

[notice]
fast_default_opt_out = true

[experimental_network.unix_sockets]
"/tmp/agent-notifier.sock" = "allow"
"/private/tmp/tmux-__UID__/default" = "allow"
"/tmp/tmux-__UID__/default" = "allow"

[hooks]

[[hooks.UserPromptSubmit]]

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/prompt-guard.sh"
timeout = 5
statusMessage = "codex prompt guard"

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/inject-context.sh"
timeout = 30
statusMessage = "codex active plan context"

# pager: cross-session message delivery. Event name is taken from the payload,
# so no argument is passed.
#
# Stop is omitted because Codex does not honour additionalContext there — the
# only way out of a Stop hook is decision:"block" with a reason, which Codex
# turns into a continuation prompt and resumes the turn. Waking an agent up to
# hand it a message is not delivery, it is interruption. Verified 2026-08-19
# against learn.chatgpt.com/docs/hooks; the note this replaces said the support
# was merely unverified. Claude is the mirror image: it honours
# additionalContext on Stop and drops it on PostToolUse, so the two tools share
# no mid-turn injection point and the event lists differ on purpose.
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "pager hook"
timeout = 10
statusMessage = "pager delivery"

[[hooks.PreToolUse]]

[[hooks.PreToolUse.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/protect-files.sh"
timeout = 5
statusMessage = "codex file safety"

[[hooks.PostToolUse]]
matcher = "^(Write|Edit|apply_patch)$"

[[hooks.PostToolUse.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/post-edit-pipeline.sh"
timeout = 40
statusMessage = "codex edit pipeline"

[[hooks.SessionStart]]

[[hooks.SessionStart.hooks]]
type = "command"
command = "pager hook"
timeout = 10
statusMessage = "pager delivery"

[[hooks.Stop]]

[[hooks.Stop.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/stop-gate.sh"
timeout = 45
statusMessage = "codex final gate"

[[hooks.PermissionRequest]]
matcher = "*"

[[hooks.PermissionRequest.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/notify.sh approval"
timeout = 5
statusMessage = "codex approval notify"
