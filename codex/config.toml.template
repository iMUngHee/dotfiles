# codex/config.toml.template — keys ENFORCED on every bootstrap (deep-merge).
# All other keys (trust levels, NUX counters, most mcp_servers, etc.) are
# user/machine-managed and preserved by the merge. The one exception is
# mcp_servers.pager — see the comment on that block.

project_doc_max_bytes = 65536

# Enforced like every key here: a model picked locally with /model is reverted on
# the next bootstrap. That is deliberate - the model is a dotfiles decision, not a
# per-machine one - but it is the only enforced key a user is likely to change by
# hand and then wonder about, so it is called out rather than left to the header.
model = "gpt-6-astra"
model_reasoning_effort = "medium"

# Default startup automation = maximum local autonomy (no approvals + no sandbox)
approval_policy = "never"
approvals_reviewer = "user"
sandbox_mode = "danger-full-access"

[features]
apps = false
plugins = false
skill_mcp_dependency_install = false

[tui]
theme = "catppuccin-mocha"
notifications = false
vim_mode_default = true
status_line_use_colors = true
status_line = [
  "model-with-reasoning",
  "run-state",
  "task-progress",
  "context-used",
  "five-hour-limit",
  "weekly-limit",
  "current-dir",
  "git-branch",
]
terminal_title = ["app-name", "project-name", "run-state", "task-progress"]

[notice]
fast_default_opt_out = true

[experimental_network.unix_sockets]
"/tmp/agent-notifier.sock" = "allow"
"/private/tmp/tmux-__UID__/default" = "allow"
"/tmp/tmux-__UID__/default" = "allow"

# The one enforced mcp_servers entry. The rest stay machine-managed because
# Codex generates them with absolute, per-install paths (node_repl points into
# a versioned runtime directory, cua_repl at the desktop app binary) — nothing
# that survives a move to another machine. pager is the opposite: this repo
# already depends on it (ai/rules/pager.md, and the pager hooks below) and it is
# invoked by name, so one portable declaration works everywhere.
#
# Without this the MCP surface was invisible to the dotfiles: registered by
# hand on the Mac, absent on every new machine, with nothing to notice the gap.
# The deep-merge enforces only this key, so node_repl and cua_repl survive.
#
# pager itself is NOT installed by this repo on macOS/Linux — only
# windows/scripts/install-pager.ps1 builds it (upstream: github.com/iMUngHee/pager,
# `make build` → ~/.local/bin/pager). So this block is conditional at deploy time:
# codex/scripts/bootstrap.sh drops it when the binary is absent, mirroring the
# `command -v pager` guard claude/scripts/bootstrap.sh applies on the Claude side.
[mcp_servers.pager]
command = "pager"
args = ["mcp"]

[hooks]

[[hooks.UserPromptSubmit]]

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/prompt-guard.sh"
timeout = 5
statusMessage = "codex prompt guard"

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/inject-context.sh"
timeout = 30
statusMessage = "codex active plan context"

# pager: cross-session message delivery. Event name is taken from the payload,
# so no argument is passed.
#
# Stop is omitted because Codex does not honour additionalContext there — the
# only way out of a Stop hook is decision:"block" with a reason, which Codex
# turns into a continuation prompt and resumes the turn. Waking an agent up to
# hand it a message is not delivery, it is interruption. Verified 2026-08-19
# against learn.chatgpt.com/docs/hooks; the note this replaces said the support
# was merely unverified. Claude is the mirror image: it honours
# additionalContext on Stop and drops it on PostToolUse, so the two tools share
# no mid-turn injection point and the event lists differ on purpose.
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "if command -v pager >/dev/null 2>&1; then pager hook; fi"
timeout = 10
statusMessage = "pager delivery"

[[hooks.PreToolUse]]

[[hooks.PreToolUse.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/protect-files.sh"
timeout = 5
statusMessage = "codex file safety"

[[hooks.PostToolUse]]
matcher = "^(Write|Edit|apply_patch)$"

[[hooks.PostToolUse.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/post-edit-pipeline.sh"
timeout = 40
statusMessage = "codex edit pipeline"

[[hooks.SessionStart]]

[[hooks.SessionStart.hooks]]
type = "command"
command = "if command -v pager >/dev/null 2>&1; then pager hook; fi"
timeout = 10
statusMessage = "pager delivery"

[[hooks.Stop]]

[[hooks.Stop.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/stop-gate.sh"
timeout = 45
statusMessage = "codex final gate"

[[hooks.PermissionRequest]]
matcher = "*"

[[hooks.PermissionRequest.hooks]]
type = "command"
command = "$HOME/.config/codex/hooks/notify.sh approval"
timeout = 5
statusMessage = "codex approval notify"
